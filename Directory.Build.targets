<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Package inputs are collected at pack time, never during consumer restore/build. -->
  <ItemGroup Condition="'$(TrellisShipsApiReferenceSet)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)docs\docfx_project\api_reference\*.md"
          Exclude="$(MSBuildThisFileDirectory)docs\docfx_project\api_reference\completeness-report.md"
          Pack="true" PackagePath="trellis/" />
  </ItemGroup>

  <ItemGroup Condition="'$(TrellisShipsOwnApiReference)' == 'true' AND '$(TrellisApiRefName)' != ''">
    <None Include="$(MSBuildThisFileDirectory)docs\docfx_project\api_reference\trellis-api-$(TrellisApiRefName).md"
          Pack="true" PackagePath="trellis/" />
  </ItemGroup>

  <ItemGroup Condition="'$(TrellisShipsApiReferenceSet)' == 'true' OR '$(TrellisShipsOwnApiReference)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)build\Trellis.ApiReference.targets"
          Pack="true" PackagePath="build/$(PackageId).targets" />
    <None Include="$(MSBuildThisFileDirectory)build\Trellis.ApiReference.targets"
          Pack="true" PackagePath="buildTransitive/$(PackageId).targets" />
  </ItemGroup>

  <Target Name="GenerateTrellisReferenceManifest" BeforeTargets="_GetPackageFiles"
          Condition="'$(IsPackable)' != 'false'">
    <PropertyGroup>
      <_TrellisReferenceManifest>$(IntermediateOutputPath)reference-manifest.json</_TrellisReferenceManifest>
    </PropertyGroup>
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildThisFileDirectory)build/generate-reference-manifest.ps1&quot; -RepositoryRoot &quot;$(MSBuildThisFileDirectory)build&quot; -Project &quot;$(MSBuildProjectFullPath)&quot; -Output &quot;$(MSBuildProjectDirectory)/$(_TrellisReferenceManifest)&quot; -Mode &quot;$(TrellisShipsApiReferenceSet);$(TrellisShipsOwnApiReference)&quot;" />
    <ItemGroup>
      <None Include="$(_TrellisReferenceManifest)" Pack="true"
            PackagePath="guidance/reference-manifest.json" />
    </ItemGroup>
  </Target>

  <Target Name="LintApiReference" BeforeTargets="Build"
          Condition="'$(TrellisEnableApiReferenceLint)' == 'true' AND '$(DesignTimeBuild)' != 'true' AND '$(BuildingForLiveUnitTesting)' != 'true'">
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)docs/lint-api-reference.ps1&quot;" />
  </Target>
</Project>
