<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!--
    Auto-pack API reference markdown and shared .targets for any Trellis package
    that sets TrellisApiRefName (e.g., <TrellisApiRefName>asp</TrellisApiRefName>).
  -->
  <ItemGroup Condition="'$(TrellisApiRefName)' != ''">
    <None Include="$(MSBuildThisFileDirectory)docs\docfx_project\api_reference\trellis-api-$(TrellisApiRefName).md"
          Pack="true" PackagePath="trellis\" />
    <None Include="$(MSBuildThisFileDirectory)build\Trellis.ApiReference.targets"
          Pack="true" PackagePath="build\$(PackageId).targets" />
    <None Include="$(MSBuildThisFileDirectory)build\Trellis.ApiReference.targets"
          Pack="true" PackagePath="buildTransitive\$(PackageId).targets" />
  </ItemGroup>

  <!--
    Cross-cutting references ship once, in Trellis.Core (Core is referenced by
    every Trellis service so this guarantees they always land in .github/).
    These are package-agnostic: the cookbook spans every package, while the
    anti-pattern gallery and the value-object taxonomy describe rules that hold
    regardless of which packages are installed, so no single feature package
    owns them and TrellisApiRefName cannot ship them.
    Opt in per package by setting <TrellisShipsCrossCuttingDocs>true</TrellisShipsCrossCuttingDocs>.
  -->
  <ItemGroup Condition="'$(TrellisShipsCrossCuttingDocs)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)docs\docfx_project\api_reference\trellis-start-here.md"
          Pack="true" PackagePath="trellis\" />
    <None Include="$(MSBuildThisFileDirectory)docs\docfx_project\api_reference\trellis-api-cookbook.md"
          Pack="true" PackagePath="trellis\" />
    <None Include="$(MSBuildThisFileDirectory)docs\docfx_project\api_reference\trellis-api-anti-patterns.md"
          Pack="true" PackagePath="trellis\" />
    <None Include="$(MSBuildThisFileDirectory)docs\docfx_project\api_reference\trellis-value-object-taxonomy.md"
          Pack="true" PackagePath="trellis\" />
  </ItemGroup>

  <Target Name="LintApiReference"
          BeforeTargets="Build"
          Condition="'$(TrellisEnableApiReferenceLint)' == 'true' AND '$(DesignTimeBuild)' != 'true' AND '$(BuildingForLiveUnitTesting)' != 'true'">
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)docs/lint-api-reference.ps1&quot;" />
  </Target>
</Project>
