<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Package inputs are collected at pack time, never during consumer restore/build.
       Trellis.Core is the only package that ships guidance: the reference set plus its manifest.
       Every other package relies on Core, so consumers approve one package with the AgentDocs tool. -->
  <PropertyGroup>
    <_TrellisOwnSourceDirectory>$([MSBuild]::NormalizePath($(MSBuildThisFileDirectory), $(MSBuildProjectName), src))</_TrellisOwnSourceDirectory>
    <TrellisPowerShellExecutable Condition="'$(TrellisPowerShellExecutable)' == ''">pwsh</TrellisPowerShellExecutable>
    <_TrellisReasonCodeGuardApplies Condition="'$(TrellisEnableReasonCodeGuard)' == 'true' AND
                                            '$(MSBuildProjectExtension)' == '.csproj' AND
                                            '$(MSBuildProjectName)' != 'Trellis.Analyzers' AND
                                            '$(IsTestProject)' != 'true' AND
                                            $([System.Text.RegularExpressions.Regex]::IsMatch('$(MSBuildProjectDirectory)', '(^|[\\/])src([\\/]|$)'))">true</_TrellisReasonCodeGuardApplies>
    <_TrellisReasonCodeGuardAnalyzer>$(MSBuildThisFileDirectory)Trellis.Analyzers\src\bin\$(Configuration)\netstandard2.0\Trellis.Analyzers.dll</_TrellisReasonCodeGuardAnalyzer>
    <_TrellisReasonCodeGuardConfiguration>$(MSBuildThisFileDirectory)build\reason-code-guard.globalconfig</_TrellisReasonCodeGuardConfiguration>
  </PropertyGroup>

  <Target Name="ValidateReasonCodeGuard" BeforeTargets="CoreCompile"
          Condition="'$(_TrellisReasonCodeGuardApplies)' == 'true'">
    <Error Condition="!Exists('$(_TrellisReasonCodeGuardAnalyzer)')"
           Text="Build Trellis.Analyzers before enabling the reason-code guard (Configuration=$(Configuration))." />
    <Error Condition="!Exists('$(_TrellisReasonCodeGuardConfiguration)')"
           Text="Reason-code guard configuration is missing: $(_TrellisReasonCodeGuardConfiguration)." />
    <Error Condition="'$(RunAnalyzers)' == 'false' OR '$(RunAnalyzersDuringBuild)' == 'false'"
           Text="The reason-code guard requires analyzers to run during the build." />
    <ItemGroup>
      <_TrellisExistingAnalyzer Include="@(Analyzer)"
                              Condition="'%(Analyzer.Filename)' == 'Trellis.Analyzers'" />
      <Analyzer Include="$(_TrellisReasonCodeGuardAnalyzer)"
                Condition="'@(_TrellisExistingAnalyzer)' == ''" />
      <EditorConfigFiles Include="$(_TrellisReasonCodeGuardConfiguration)"
                         Condition="'@(_TrellisExistingAnalyzer)' == ''" />
    </ItemGroup>
    <PropertyGroup>
      <WarningsAsErrors>$(WarningsAsErrors);TRLS067</WarningsAsErrors>
    </PropertyGroup>
  </Target>

  <ItemGroup Condition="'$(TrellisShipsApiReferenceSet)' == 'true' AND '$(IsPackable)' != 'false' AND
                        '$(_TrellisOwnSourceDirectory)' == '$([MSBuild]::NormalizePath($(MSBuildProjectDirectory)))'">
    <PackageGuidanceItem Include="$(MSBuildThisFileDirectory)docs\docfx_project\api_reference\*.md"
                         Exclude="$(MSBuildThisFileDirectory)docs\docfx_project\api_reference\completeness-report.md"
                         PackagePath="trellis/%(Filename)%(Extension)" />
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)build\Trellis.Guidance.Metadata.targets"
          Condition="'$(TrellisShipsApiReferenceSet)' == 'true' AND '$(IsPackable)' != 'false' AND
                     '$(_TrellisOwnSourceDirectory)' == '$([MSBuild]::NormalizePath($(MSBuildProjectDirectory)))'" />

  <Target Name="LintApiReference" BeforeTargets="Build"
          Condition="'$(TrellisEnableApiReferenceLint)' == 'true' AND '$(DesignTimeBuild)' != 'true' AND '$(BuildingForLiveUnitTesting)' != 'true'">
    <Exec Command="&quot;$(TrellisPowerShellExecutable)&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)docs/lint-api-reference.ps1&quot;"
          IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="_TrellisApiReferenceLintExitCode" />
    </Exec>
    <Error Condition="'$(_TrellisApiReferenceLintExitCode)' == '9009' OR '$(_TrellisApiReferenceLintExitCode)' == '127'"
           Text="PowerShell 7 could not be started for API reference lint. Install PowerShell 7 and ensure pwsh is on PATH, or set TrellisPowerShellExecutable to its full path. Restart Visual Studio after changing PATH." />
    <Error Condition="'$(_TrellisApiReferenceLintExitCode)' != '0' AND '$(_TrellisApiReferenceLintExitCode)' != '9009' AND '$(_TrellisApiReferenceLintExitCode)' != '127'"
           Text="API reference lint failed with exit code $(_TrellisApiReferenceLintExitCode). See the lint output above." />
  </Target>
</Project>
