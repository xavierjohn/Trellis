<!-- https://learn.microsoft.com/dotnet/fundamentals/package-validation/diagnostic-ids -->
<!--
  CP0002 on RuleViolationProblemDetail: the record's third positional member changed from
  'string[] Fields' - a bare array of JSON Pointer strings - to
  'IReadOnlyList<ViolationLocation> Locations'. The old shape could only ever assert "these are
  pointers into the body", which is false for a rule spanning a query parameter or a header, and
  there was no member in which to say otherwise. This is a deliberate wire-shape break, called out
  in the breaking-changes section of the release notes.
-->
<Suppressions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Suppression>
    <DiagnosticId>CP0002</DiagnosticId>
    <Target>M:Trellis.Asp.RuleViolationProblemDetail.#ctor(System.String,System.String,System.String[])</Target>
    <Left>lib/net10.0/Trellis.Asp.dll</Left>
    <Right>lib/net10.0/Trellis.Asp.dll</Right>
    <IsBaselineSuppression>true</IsBaselineSuppression>
  </Suppression>
  <Suppression>
    <DiagnosticId>CP0002</DiagnosticId>
    <Target>M:Trellis.Asp.RuleViolationProblemDetail.Deconstruct(System.String@,System.String@,System.String[]@)</Target>
    <Left>lib/net10.0/Trellis.Asp.dll</Left>
    <Right>lib/net10.0/Trellis.Asp.dll</Right>
    <IsBaselineSuppression>true</IsBaselineSuppression>
  </Suppression>
  <Suppression>
    <DiagnosticId>CP0002</DiagnosticId>
    <Target>M:Trellis.Asp.RuleViolationProblemDetail.get_Fields</Target>
    <Left>lib/net10.0/Trellis.Asp.dll</Left>
    <Right>lib/net10.0/Trellis.Asp.dll</Right>
    <IsBaselineSuppression>true</IsBaselineSuppression>
  </Suppression>
  <Suppression>
    <DiagnosticId>CP0002</DiagnosticId>
    <Target>M:Trellis.Asp.RuleViolationProblemDetail.set_Fields(System.String[])</Target>
    <Left>lib/net10.0/Trellis.Asp.dll</Left>
    <Right>lib/net10.0/Trellis.Asp.dll</Right>
    <IsBaselineSuppression>true</IsBaselineSuppression>
  </Suppression>
</Suppressions>