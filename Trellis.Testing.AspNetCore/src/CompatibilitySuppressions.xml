<?xml version="1.0" encoding="utf-8"?>
<!-- https://learn.microsoft.com/dotnet/fundamentals/package-validation/diagnostic-ids -->
<!--
  CP0002 on ExpectedOutcome: the record gained a fourth positional member,
  'string? ContentType', so its primary constructor and Deconstruct signatures changed.

  The addition exists because asserting only status and headers let a real RFC 9457 regression
  through: applying [Produces("application/json")] rewrites a problem response's media type while
  leaving its status code and body intact, so a harness that never looks at content type is
  structurally incapable of seeing it. A positional member keeps `# @expect content-type:` a
  first-class part of the expectation rather than a bolt-on.

  Deliberate break, and cheap here: this is a test-harness type in a 3.0.0-alpha package.
-->
<Suppressions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Suppression>
    <DiagnosticId>CP0002</DiagnosticId>
    <Target>M:Trellis.Testing.AspNetCore.Http.ExpectedOutcome.#ctor(System.Nullable{System.Int32},System.Nullable{System.Int32},System.Collections.Generic.IReadOnlyList{System.String})</Target>
    <Left>lib/net10.0/Trellis.Testing.AspNetCore.dll</Left>
    <Right>lib/net10.0/Trellis.Testing.AspNetCore.dll</Right>
    <IsBaselineSuppression>true</IsBaselineSuppression>
  </Suppression>
  <Suppression>
    <DiagnosticId>CP0002</DiagnosticId>
    <Target>M:Trellis.Testing.AspNetCore.Http.ExpectedOutcome.Deconstruct(System.Nullable{System.Int32}@,System.Nullable{System.Int32}@,System.Collections.Generic.IReadOnlyList{System.String}@)</Target>
    <Left>lib/net10.0/Trellis.Testing.AspNetCore.dll</Left>
    <Right>lib/net10.0/Trellis.Testing.AspNetCore.dll</Right>
    <IsBaselineSuppression>true</IsBaselineSuppression>
  </Suppression>
</Suppressions>