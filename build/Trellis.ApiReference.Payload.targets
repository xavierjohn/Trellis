<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Import only in a satellite publisher's project; do not pack this target into consumer packages. -->
  <Target Name="GenerateTrellisSatelliteReferenceManifest" BeforeTargets="_GetPackageFiles"
          Condition="'$(TrellisPublishSatelliteGuidance)' == 'true' AND '$(IsPackable)' != 'false'">
    <Error Condition="'$(TrellisApiRefName)' == ''"
           Text="Set TrellisApiRefName to the satellite reference filename suffix." />
    <PropertyGroup>
      <_TrellisSatelliteDocument>$(MSBuildProjectDirectory)\trellis\trellis-api-$(TrellisApiRefName).md</_TrellisSatelliteDocument>
      <_TrellisSatelliteManifest>$(IntermediateOutputPath)reference-manifest.json</_TrellisSatelliteManifest>
    </PropertyGroup>
    <Error Condition="!Exists('$(_TrellisSatelliteDocument)')"
           Text="Missing satellite guidance document $(_TrellisSatelliteDocument)." />
    <GetFileHash Files="$(_TrellisSatelliteDocument)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_TrellisSatelliteHash" />
    </GetFileHash>
    <WriteLinesToFile File="$(_TrellisSatelliteManifest)" Overwrite="true" Encoding="UTF-8"
                      Lines='{"schemaVersion":1,"documents":[{"path":"trellis/trellis-api-$(TrellisApiRefName).md","sha256":"$(_TrellisSatelliteHash.ToLowerInvariant())"}],"entryPoints":["trellis/trellis-api-$(TrellisApiRefName).md"]}' />
    <ItemGroup>
      <None Include="$(_TrellisSatelliteManifest)" Pack="true"
            PackagePath="guidance/reference-manifest.json" />
    </ItemGroup>
  </Target>
</Project>
